#:kivy 2.2.0

<VisionRoot>:
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 0.05, 0.06, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "Vision Companion"
        size_hint_y: None
        height: dp(48)
        font_size: "28sp"
        bold: True
        color: 0.76, 0.93, 1, 1

    Label:
        text: "100% voice-controlled offline navigation"
        size_hint_y: None
        height: dp(32)
        font_size: "16sp"
        color: 0.80, 0.87, 0.96, 1

    GridLayout:
        size_hint_y: None
        height: dp(100)
        cols: 2
        spacing: dp(10)

        BoxLayout:
            orientation: "vertical"
            padding: dp(8)
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "Navigation"
                color: 0.75, 0.82, 0.98, 1
                font_size: "14sp"
            Label:
                text: root.status_text
                color: 0.43, 0.95, 0.55, 1
                bold: True
                font_size: "18sp"

        BoxLayout:
            orientation: "vertical"
            padding: dp(8)
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "Voice State"
                color: 0.75, 0.82, 0.98, 1
                font_size: "14sp"
            Label:
                text: root.listen_state
                color: 1, 1, 1, 1
                font_size: "16sp"

    Label:
        text: root.permission_text
        size_hint_y: None
        height: dp(44)
        color: 0.97, 0.90, 0.52, 1
        text_size: self.width, None
        halign: "center"
        valign: "middle"

    BoxLayout:
        size_hint_y: None
        height: dp(54)
        spacing: dp(8)

        Button:
            text: "Enable Voice"
            bold: True
            background_normal: ""
            background_color: 0.20, 0.55, 0.90, 1
            on_release: app.start_voice_engine()

        Button:
            text: "Disable Voice"
            bold: True
            background_normal: ""
            background_color: 0.35, 0.37, 0.45, 1
            on_release: app.stop_voice_engine()

    ScrollView:
        do_scroll_x: False
        bar_width: dp(6)

        Label:
            text: root.scene_text
            size_hint_y: None
            height: max(self.texture_size[1] + dp(22), dp(140))
            text_size: self.width - dp(10), None
            halign: "left"
            valign: "top"
            color: 1, 1, 1, 1
            font_size: "21sp"
            padding: dp(8), dp(8)

    Label:
        size_hint_y: None
        height: dp(76)
        text: "Voice commands: Start safe navigation, Stop safe navigation, What's ahead, Describe my surroundings, Tell me what is in front of me, Help, Repeat"
        color: 0.82, 0.87, 0.96, 1
        text_size: self.width, None
        halign: "center"
        valign: "middle"
        font_size: "14sp"
