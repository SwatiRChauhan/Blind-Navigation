#:kivy 2.2.0

<VisionRoot>:
    orientation: "vertical"
    padding: dp(14)
    spacing: dp(10)
    canvas.before:
        Color:
            rgba: 0.05, 0.06, 0.10, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "Vision Companion"
        size_hint_y: None
        height: dp(48)
        font_size: "28sp"
        bold: True
        color: 0.76, 0.93, 1, 1

    Label:
        text: "Offline blind-safe navigation"
        size_hint_y: None
        height: dp(32)
        font_size: "16sp"
        color: 0.80, 0.87, 0.96, 1

    GridLayout:
        size_hint_y: None
        height: dp(94)
        cols: 2
        spacing: dp(10)

        BoxLayout:
            orientation: "vertical"
            padding: dp(8)
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "Status"
                color: 0.75, 0.82, 0.98, 1
                font_size: "14sp"
            Label:
                text: root.status_text
                color: 0.43, 0.95, 0.55, 1
                bold: True
                font_size: "18sp"

        BoxLayout:
            orientation: "vertical"
            padding: dp(8)
            canvas.before:
                Color:
                    rgba: 0.10, 0.12, 0.18, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "Vision Engine"
                color: 0.75, 0.82, 0.98, 1
                font_size: "14sp"
            Label:
                text: root.vision_state
                color: 1, 1, 1, 1
                font_size: "16sp"

    Label:
        text: root.permission_text
        size_hint_y: None
        height: dp(44)
        color: 0.97, 0.90, 0.52, 1
        text_size: self.width, None
        halign: "center"
        valign: "middle"

    ScrollView:
        do_scroll_x: False
        bar_width: dp(6)

        Label:
            text: root.scene_text
            size_hint_y: None
            height: max(self.texture_size[1] + dp(22), dp(130))
            text_size: self.width - dp(10), None
            halign: "left"
            valign: "top"
            color: 1, 1, 1, 1
            font_size: "21sp"
            padding: dp(8), dp(8)

    BoxLayout:
        size_hint_y: None
        height: dp(56)
        spacing: dp(8)

        TextInput:
            text: root.command_input
            on_text: root.command_input = self.text
            multiline: False
            hint_text: "Voice/typed command fallback"
            font_size: "18sp"
            padding: dp(12), dp(14)
            background_normal: ""
            background_active: ""
            background_color: 0.16, 0.18, 0.25, 1
            foreground_color: 1, 1, 1, 1
            cursor_color: 0.6, 0.9, 1, 1

        Button:
            text: "Send"
            size_hint_x: 0.32
            bold: True
            font_size: "18sp"
            background_normal: ""
            background_color: 0.20, 0.55, 0.90, 1
            on_release: app.on_submit_command()

    Label:
        size_hint_y: None
        height: dp(64)
        text: "Commands: Start safe navigation, Stop safe navigation, What is ahead, Describe surroundings, Help, Repeat"
        color: 0.82, 0.87, 0.96, 1
        text_size: self.width, None
        halign: "center"
        valign: "middle"
        font_size: "14sp"
