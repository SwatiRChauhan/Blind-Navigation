#:kivy 2.2.0

<VisionRoot>:
    orientation: "vertical"
    padding: dp(16)
    spacing: dp(12)
    canvas.before:
        Color:
            rgba: 0.03, 0.04, 0.08, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "Vision Companion"
        size_hint_y: None
        height: dp(52)
        font_size: "40sp"
        bold: True
        color: 1, 1, 1, 1

    Label:
        text: "Audio-first blind navigation assistant"
        size_hint_y: None
        height: dp(24)
        font_size: "16sp"
        color: 0.72, 0.82, 0.96, 1

    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"

        BoxLayout:
            orientation: "vertical"
            size_hint: None, None
            size: dp(280), dp(280)
            padding: dp(20)
            canvas.before:
                Color:
                    rgba: (0.00, 0.30, 0.25, 0.35) if root.active else (0.00, 0.20, 0.18, 0.25)
                Ellipse:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: 0.00, 0.85, 0.65, 1
                Line:
                    width: 3
                    circle: self.center_x, self.center_y, min(self.width, self.height) / 2

            Widget:
            Label:
                text: "🎙️" if root.listening else "🔇"
                font_size: "56sp"
                color: 0.00, 0.88, 0.70, 1
                size_hint_y: None
                height: dp(70)
            Label:
                text: root.status_text
                bold: True
                font_size: "28sp"
                color: 0.00, 0.90, 0.72, 1
                size_hint_y: None
                height: dp(42)
            Widget:

    GridLayout:
        cols: 2
        size_hint_y: None
        height: dp(90)
        spacing: dp(10)

        BoxLayout:
            orientation: "vertical"
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.10, 0.11, 0.16, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "GPS"
                font_size: "13sp"
                color: 0.58, 0.63, 0.75, 1
                halign: "left"
                text_size: self.size
            Label:
                text: root.gps_state
                bold: True
                font_size: "22sp"
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

        BoxLayout:
            orientation: "vertical"
            padding: dp(10)
            canvas.before:
                Color:
                    rgba: 0.10, 0.11, 0.16, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [12, 12, 12, 12]
            Label:
                text: "VISION"
                font_size: "13sp"
                color: 0.58, 0.63, 0.75, 1
                halign: "left"
                text_size: self.size
            Label:
                text: root.vision_state
                bold: True
                font_size: "22sp"
                color: 1, 1, 1, 1
                halign: "left"
                text_size: self.size

    Label:
        text: root.listen_state
        size_hint_y: None
        height: dp(28)
        font_size: "16sp"
        color: 0.65, 0.95, 0.82, 1

    Label:
        text: root.scene_text
        text_size: self.width, None
        halign: "center"
        valign: "middle"
        color: 1, 1, 1, 1
        font_size: "18sp"

    Label:
        text: root.permission_text
        size_hint_y: None
        height: dp(26)
        font_size: "12sp"
        color: 0.90, 0.85, 0.55, 1
